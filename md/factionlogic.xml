<?xml version="1.0" encoding="utf-8"?>
<diff>
	<!--Changes to Zyarth--> 
  <replace sel="/mdscript/cues/cue[@name='FactionLogicManagers']/cues/cue[@name='SplitFactionLogic']/cues/cue/param[@name='PreferredHQSpaceMacro']/@value">macro.cluster_rem83_sector001_macro</replace>
  <replace sel="/mdscript/cues/cue[@name='FactionLogicManagers']/cues/cue[@name='SplitFactionLogic']/cues/cue/param[@name='PreferredHQSpaceMacro']/@comment">Patriarch's Seat</replace>
	<!--Changes to Free Families--> 
  <replace sel="/mdscript/cues/cue[@name='FactionLogicManagers']/cues/cue[@name='FreeSplitFactionLogic']/cues/cue/param[@name='PreferredHQSpaceMacro']/@value">macro.cluster_407_sector001_macro</replace>
  <replace sel="/mdscript/cues/cue[@name='FactionLogicManagers']/cues/cue[@name='FreeSplitFactionLogic']/cues/cue/param[@name='PreferredHQSpaceMacro']/@comment">Family Tkr</replace>
  
 
  <add sel="//cue[@name='FactionLogicManagers']/cues">
	<cue name="SetupFactions" version="2">
	  <actions>
		<set_value name="md.$FactionData.{faction.aldrin}" exact="table[]" />	  
		<set_value name="md.$FactionData.{faction.otas}" exact="table[]" />
		<set_value name="md.$FactionData.{faction.strongarms}" exact="table[]" />
		<set_value name="md.$FactionData.{faction.atreus}" exact="table[]" />
		<set_value name="md.$FactionData.{faction.xaar}" exact="table[]" />
		<set_value name="md.$FactionData.{faction.enclave}" exact="table[]" />						
	  </actions>
	  <patch sinceversion="2">
		<set_value name="AldrinFactionLogic.$PreferredHQSpaceMacro" exact="macro.cluster_rem92_sector001_macro" /><!--Aldrin I-->	  
		<set_value name="OTASFactionLogic.$PreferredHQSpaceMacro" exact="macro.cluster_rem53_sector001_macro" /><!--Legend's Home-->
		<set_value name="StrongArmsFactionLogic.$PreferredHQSpaceMacro" exact="macro.cluster_03_sector001_macro" /><!--Thyn's Excavation-->
		<set_value name="AtreusFactionLogic.$PreferredHQSpaceMacro" exact="macro.cluster_rem37_sector001_macro" /><!--Queen's Harbour-->
		<set_value name="XaarFactionLogic.$PreferredHQSpaceMacro" exact="macro.cluster_rem50_sector001_macro" /> <!--Emperor's Wisdom-->
		<set_value name="EnclaveFactionLogic.$PreferredHQSpaceMacro" exact="macro.cluster_rem62_sector001_macro" /> <!--Argon Sector M148-->			
	  </patch>
	</cue>	

	<cue name="AldrinFactionLogic">
	  <cues>
		<cue name="AldrinFactionLogic_Manager" ref="Manager">
		  <param name="Faction" value="faction.aldrin"/>
		  <param name="BaseAggressionLevel" value="moodlevel.normal"/>
		  <param name="BaseAvariceLevel" value="moodlevel.low"/>
		  <param name="BaseLawfulness" value="0.8"/>
		  <param name="PreferredHQSpaceMacro" value="macro.cluster_rem92_sector001_macro" comment="Aldrin I"/>
		  <param name="PreferredHQTypes" value="['shipbuilding', 'equipmentdock', 'tradestation']"/>
		  <param name="SatelliteNetworkGoal" value="7"/>
		  <param name="LasertowerNetworkGoal" value="7"/>
		  <param name="DebugChance" value="0"/>
		  <param name="DebugChance2" value="0"/>
		</cue>
	  </cues>
	</cue>	
	<cue name="OTASFactionLogic">
	  <cues>
		<cue name="OTASFactionLogic_Manager" ref="Manager">
		  <param name="Faction" value="faction.otas"/>
		  <param name="BaseAggressionLevel" value="moodlevel.high"/>
		  <param name="BaseAvariceLevel" value="moodlevel.normal"/>
		  <param name="BaseLawfulness" value="0.6"/>
		  <param name="PreferredHQSpaceMacro" value="macro.cluster_rem53_sector001_macro" comment="Legend's Home"/>
		  <param name="PreferredHQTypes" value="['shipbuilding', 'equipmentdock', 'tradestation']"/>
		  <param name="SatelliteNetworkGoal" value="2"/>
		  <param name="LasertowerNetworkGoal" value="2"/>
          <param name="MinefieldGoalPerSector" value="3" comment="[MGPS * Sectors, 12].min is the maximum amount of Minefields for this faction"/>		  
		  <param name="DebugChance" value="0"/>
		  <param name="DebugChance2" value="0"/>
		</cue>
	  </cues>
	</cue>
	<cue name="StrongArmsFactionLogic">
	  <cues>
		<cue name="StrongArmsFactionLogic_Manager" ref="Manager">
		  <param name="Faction" value="faction.strongarms"/>
		  <param name="BaseAggressionLevel" value="moodlevel.high"/>
		  <param name="BaseAvariceLevel" value="moodlevel.normal"/>
		  <param name="BaseLawfulness" value="0.2"/>
		  <param name="PreferredHQSpaceMacro" value="macro.cluster_rem34_sector001_macro" comment="Thyn's Excavation"/>
		  <param name="PreferredHQTypes" value="['shipbuilding', 'equipmentdock', 'tradestation']"/>
		  <param name="SatelliteNetworkGoal" value="2"/>
		  <param name="LasertowerNetworkGoal" value="3"/>
          <param name="MinefieldGoalPerSector" value="5" comment="[MGPS * Sectors, 12].min is the maximum amount of Minefields for this faction"/>		  
		  <param name="DebugChance" value="0"/>
		  <param name="DebugChance2" value="0"/>
		</cue>
	  </cues>
	</cue>
	<cue name="AtreusFactionLogic">
	  <cues>
		<cue name="AtreusFactionLogic_Manager" ref="Manager">
		  <param name="Faction" value="faction.atreus"/>
		  <param name="BaseAggressionLevel" value="moodlevel.normal"/>
		  <param name="BaseAvariceLevel" value="moodlevel.normal"/>
		  <param name="BaseLawfulness" value="0.8"/>
		  <param name="PreferredHQSpaceMacro" value="macro.cluster_rem37_sector001_macro" comment="Queen's Harbour"/>
		  <param name="PreferredHQTypes" value="['shipbuilding', 'equipmentdock', 'tradestation']"/>
		  <param name="SatelliteNetworkGoal" value="2"/>
		  <param name="LasertowerNetworkGoal" value="4"/>
          <param name="MinefieldGoalPerSector" value="3" comment="[MGPS * Sectors, 12].min is the maximum amount of Minefields for this faction"/>		  
		  <param name="DebugChance" value="0"/>
		  <param name="DebugChance2" value="0"/>
		</cue>
	  </cues>
	</cue>
	<cue name="XaarFactionLogic">
	  <cues>
		<cue name="XaarFactionLogic_Manager" ref="Manager">
		  <param name="Faction" value="faction.xaar"/>
		  <param name="BaseAggressionLevel" value="moodlevel.high"/>
		  <param name="BaseAvariceLevel" value="moodlevel.normal"/>
		  <param name="BaseLawfulness" value="0.8"/>
		  <param name="PreferredHQSpaceMacro" value="macro.cluster_rem50_sector001_macro" comment="Emperor's Wisdom"/>
		  <param name="PreferredHQTypes" value="['shipbuilding', 'equipmentdock', 'tradestation']"/>
		  <param name="SatelliteNetworkGoal" value="3"/>
		  <param name="LasertowerNetworkGoal" value="5"/>
          <param name="MinefieldGoalPerSector" value="4" comment="[MGPS * Sectors, 12].min is the maximum amount of Minefields for this faction"/>		  
		  <param name="DebugChance" value="0"/>
		  <param name="DebugChance2" value="0"/>
		</cue>
	  </cues>
	</cue>
	<cue name="EnclaveFactionLogic">
	  <cues>
		<cue name="EnclaveFactionLogic_Manager" ref="Manager">
		  <param name="Faction" value="faction.enclave"/>
		  <param name="BaseAggressionLevel" value="moodlevel.high"/>
		  <param name="BaseAvariceLevel" value="moodlevel.low"/>
		  <param name="BaseLawfulness" value="0.9"/>
		  <param name="PreferredHQSpaceMacro" value="macro.cluster_rem62_sector001_macro" comment="Argon Sector M148"/>
		  <param name="PreferredHQTypes" value="['shipbuilding', 'equipmentdock', 'tradestation']"/>
		  <param name="SatelliteNetworkGoal" value="2"/>
		  <param name="LasertowerNetworkGoal" value="2"/>
          <param name="MinefieldGoalPerSector" value="3" comment="[MGPS * Sectors, 12].min is the maximum amount of Minefields for this faction"/>		  
		  <param name="DebugChance" value="0"/>
		  <param name="DebugChance2" value="0"/>
		</cue>
	  </cues>
	</cue>	
  </add>	
</diff>